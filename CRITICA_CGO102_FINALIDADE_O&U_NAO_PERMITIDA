SELECT DISTINCT A.NROPEDVENDA, A.NROEMPRESA, 'CGO 102 Finalidade Nao Perm.' CODCRITICA
FROM CONSINCO.MAD_PEDVENDA A
INNER JOIN CONSINCO.MAD_PEDVENDAITEM B ON A.NROPEDVENDA = B.NROPEDVENDA
AND A.NROEMPRESA  = B.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODUTO C      ON C.SEQPRODUTO  = B.SEQPRODUTO
INNER JOIN CONSINCO.MAP_FAMDIVISAO D   ON D.SEQFAMILIA  = C.SEQFAMILIA
WHERE A.SITUACAOPED != 'C'
AND A.CODGERALOPER = 102
AND D.FINALIDADEFAMILIA NOT IN ('O','U')
AND A.DTAINCLUSAO >= SYSDATE - 30;

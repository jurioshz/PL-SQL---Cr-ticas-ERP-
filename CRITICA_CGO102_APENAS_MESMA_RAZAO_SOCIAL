SELECT DISTINCT A.NROPEDVENDA, A.NROEMPRESA, 'CGO 102 Apenas Mesma Razao Soc' CODCRITICA
FROM CONSINCO.MAD_PEDVENDA A
INNER JOIN CONSINCO.GE_PESSOA B ON A.SEQPESSOA = B.SEQPESSOA
INNER JOIN CONSINCO.MAX_EMPRESA E ON A.NROEMPRESA = E.NROEMPRESA
WHERE A.SITUACAOPED != 'C'
AND A.CODGERALOPER = 102
AND SUBSTR(LPAD(B.NROCGCCPF,13,0),0,9) != SUBSTR(LPAD(E.NROCGC,13,0),0,9)
AND A.DTAINCLUSAO >= SYSDATE - 30

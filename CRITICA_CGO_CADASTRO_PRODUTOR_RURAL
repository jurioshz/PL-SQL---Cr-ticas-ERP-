Solicitado por: Denise

SELECT DISTINCT (A.SEQAUXNOTAFISCAL) AS SEQAUXNOTAFISCAL,
                A.NUMERONF,
                A.NROEMPRESA,
                0 SEQAUXNFITEM,
                'B' BLOQAUTOR,
                115 CODINCONSITEC,
                'CGO ' || A.CODGERALOPER ||
                ' Permitido apenas para fornecedor produtor Rural. Verifique com o cadastro comercial!.' MENSAGEM
  FROM consinco.MLF_AUXNOTAFISCAL A
 INNER JOIN consinco.GE_PESSOA G
    ON G.SEQPESSOA = A.SEQPESSOA
 WHERE A.CODGERALOPER IN
       (83, 853, 12, 19, 81, 82, 84, 85, 104, 200, 203, 204, 254, 255, 900)
   AND NVL(G.INDPRODRURAL, 'N') != 'S'

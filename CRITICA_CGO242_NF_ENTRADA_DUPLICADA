-- TICKET: 748273

SELECT DISTINCT X.NROPEDVENDA, X.NROEMPRESA,'CGO 242 NF Entr. já retornada' CODCRITICA
FROM CONSINCO.MAD_PEDVENDA X INNER JOIN CONSINCO.MAD_PEDVENDAITEM Y ON X.NROPEDVENDA = Y.NROPEDVENDA
AND X.NROEMPRESA  = Y.NROEMPRESA
WHERE X.SITUACAOPED != 'C'
AND X.CODGERALOPER = 242
AND Y.NR_NUMERO IS NOT NULL
AND EXISTS (SELECT 1 FROM CONSINCO.MAD_PEDVENDA Z INNER JOIN CONSINCO.MAD_PEDVENDAITEM A ON Z.NROPEDVENDA = A.NROPEDVENDA
AND Z.NROEMPRESA = A.NROEMPRESA WHERE Z.CODGERALOPER = 242
AND Z.SITUACAOPED != 'C'
AND A.NR_NUMERO = Y.NR_NUMERO
AND A.NR_SERIE = Y.NR_SERIE
AND A.NR_NROEMPRESA = Y.NR_NROEMPRESA
AND A.NR_SEQITEM = Y.NR_SEQITEM
AND (Z.NROPEDVENDA != X.NROPEDVENDA OR Z.NROEMPRESA != X.NROEMPRESA))
AND X.DTAINCLUSAO >= SYSDATE - 30

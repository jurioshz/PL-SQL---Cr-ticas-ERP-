SELECT DISTINCT A.NROPEDVENDA, A.NROEMPRESA,
'CGO 10/78 Perm. Só Ativo Imob' MENSAGEM
FROM CONSINCO.MAD_PEDVENDA A
INNER JOIN CONSINCO.MAD_PEDVENDAITEM B ON A.NROPEDVENDA = B.NROPEDVENDA AND A.NROEMPRESA  = B.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODUTO C ON C.SEQPRODUTO  = B.SEQPRODUTO
INNER JOIN CONSINCO.MAP_FAMDIVISAO D ON D.SEQFAMILIA  = C.SEQFAMILIA
WHERE A.SITUACAOPED != 'C' 
AND A.CODGERALOPER IN (10,78) 
AND D.FINALIDADEFAMILIA != 'A' 
AND A.DTAINCLUSAO >= SYSDATE - 30

SELECT DISTINCT (X. SEQAUXNOTAFISCAL) AS SEQAUXNOTAFISCAL,
X.NUMERONF, X.NROEMPRESA, 0 SEQAUXNFITEM, 'B' BLOQAUTOR, 116 CODINCONSITEC,
'CGO 1 não permitido para fornecedor produtor rural, verifique o CGO!' MENSAGEM
FROM consinco.MLF_AUXNOTAFISCAL X
INNER JOIN consinco.GE_PESSOA Y ON Y.SEQPESSOA = X.SEQPESSOA 
WHERE X.CODGERALOPER = 1
AND Y.INDPRODRURAL = 'S'
AND X.NROEMPRESA NOT IN (53,36)

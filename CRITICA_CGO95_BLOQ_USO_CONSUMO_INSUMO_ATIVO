SELECT DISTINCT A.NROPEDVENDA,
                A.NROEMPRESA,
                'CGO 95 Bloq UsoCons/Insu/Ativo' MENSAGEM

  FROM CONSINCO.MAD_PEDVENDA A
 INNER JOIN CONSINCO.MAD_PEDVENDAITEM B
    ON B.NROPEDVENDA = A.NROPEDVENDA
   AND B.NROEMPRESA = A.NROEMPRESA
 INNER JOIN CONSINCO.MAP_PRODUTO C
    ON C.SEQPRODUTO = B.SEQPRODUTO
 INNER JOIN CONSINCO.MAP_FAMDIVISAO D
    ON D.SEQFAMILIA = C.SEQFAMILIA
 WHERE A.SITUACAOPED != 'C'
   AND A.CODGERALOPER = 95
   AND D.FINALIDADEFAMILIA IN ('U', 'O', 'A')
   AND A.NROEMPRESA NOT IN (603,508,506) -- Primeira vez travando os CD's <3
   AND A.DTAINCLUSAO >= SYSDATE - 30
;
